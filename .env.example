# === VYUHA Engine Environment Configuration ===

# Database Infrastructure
# For local SQLite dev:
DATABASE_URL=sqlite:///vyuha.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://vyuha:vyuha_secret@localhost:5432/vyuha_db

# LLM & Agent Orchestration
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# --- LLM Provider Routing (primary + fallback) ---
# Read by BOTH the CrewAI chain and the Vyuha Agent, so switching
# providers is a one-line .env edit rather than a code change.
# On OpenRouter the model ID is namespaced: vendor/model[:variant].
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Any provider failure (429 / 5xx / timeout / auth / model-unavailable)
# fails over to the fallback. Leave GROQ_API_KEY blank to disable the
# fallback — the pipeline then runs on the primary provider alone.
GROQ_API_KEY=

# TradingAgents LLM Pipeline (optional — leave TRADINGAGENTS_ENABLED=false to disable)
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_LLM_PROVIDER=openrouter
TRADINGAGENTS_DEEP_THINK_LLM=nvidia/nemotron-3-super-120b-a12b:free
TRADINGAGENTS_QUICK_THINK_LLM=nvidia/nemotron-3-super-120b-a12b:free
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_CHECKPOINT_ENABLED=false
TRADINGAGENTS_DATA_VENDORS=yfinance
TRADINGAGENTS_REQUIRE_CONFIRMATION=true
TRADINGAGENTS_HOLDING_DAYS=5
# Additional provider keys (pick whichever applies):
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=...
# OPENROUTER_API_KEY=...
# XAI_API_KEY=...
# MISTRAL_API_KEY=...
# NVIDIA_API_KEY=...
# OPENAI_COMPATIBLE_API_KEY=...  (optional, endpoint may be local/keyless)
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint/v1

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Capital Allocator Core Constraints
MONTHLY_SIP_AMOUNT=1000
MAX_POSITIONS=8
DP_CHARGE_PER_SELL=15.0

# Execution & Observability
LIVE_TRADING_ENABLED=false
EXIT_MODE=trailing_stop_only
LOG_LEVEL=INFO

# Strategy Mode
#   swing    (default) W-Bottom / BB-Squeeze swing engine — unchanged
#   investor           long-horizon portfolio profile (docs/investor_mode.md),
#                      driven by the `investor:` block of config/thresholds.yaml
STRATEGY_MODE=swing
INVESTOR_MAX_HOLDINGS=30
INVESTOR_DEFENSIVE_SYMBOLS=LIQUIDBEES,GOLDBEES

# Indian Stock Market API (news + fundamentals data)
# INDIAN_API_KEY=sk-live-...

# --- News provider -------------------------------------------------------
# The sentiment stage fetches headlines for the whole watchlist. Drishti
# accepts up to 20 symbols per request and pages to 50 articles, so a
# 105-symbol watchlist costs ~3s instead of ~84s of per-symbol scraping.
#
#   auto     use Drishti when DRISHTI_API_KEY is set, else Google News RSS
#   drishti  Drishti only
#   rss      Google News RSS only
#
# API constraints found in testing: limit > 50 returns HTTP 422, and more
# than ~20 symbols per request returns HTTP 400.
NEWS_PROVIDER=auto
# MARKET_MAX_REQUESTS_PER_DAY=50
# MARKET_SYMBOLS_PER_REQUEST=20
# MARKET_SLICE_SIZE=50

# MarketAux — primary news provider. Free tier: 100 requests/day and only
# 3 articles per request, so the watchlist is split into alternating slices
# and each run scans the next slice (state persisted in
# data/cache/marketaux_slice.json so a same-day re-run does not re-spend).
#
# IMPORTANT: Indian equities are indexed with an exchange suffix. Query
# `RELIANCE.NS`, not `RELIANCE` — a bare symbol returns spurious matches from
# other markets. 78 of 103 watchlist symbols resolve; the rest fall through
# to the Drishti/RSS providers.
# MARKET_API_KEY=your-token-here

# Drishti — optional secondary. Far more articles per request (50 vs 3) and
# covers ~75/105 symbols in 6 calls, but is budget-limited, so keep it
# disabled until you have a plan. Flip with NEWS_PROVIDER=drishti.
# DRISHTI_API_KEY=your-key-here
DRISHTI_BATCH_SIZE=20
DRISHTI_PAGE_LIMIT=50
DRISHTI_MAX_PAGES=1
DRISHTI_MIN_INTERVAL=1.2

# --- Sentiment pipeline -------------------------------------------------
# Tier 1 is a deterministic regex screen (free, ~80ms/symbol). Tier 2 is a
# chunked LLM pass, gated by FinBERT so only negative-reading symbols are
# escalated. Verdicts are cached by headline content hash.
SENTIMENT_TIER2_ENABLED=true
SENTIMENT_TIER2_TIMEOUT=30
SENTIMENT_TIER2_BATCH_SIZE=20
# FinBERT WEIGHTS are CC BY-NC-SA 4.0 (non-commercial only). The training
# code on GitHub is Apache-2.0, but that does not cover the weights.
SENTIMENT_FINBERT_ENABLED=true
SENTIMENT_FINBERT_THRESHOLD=0.50

# Hugging Face (optional, for hosted FinBERT inference)
# HF_API_TOKEN=hf_...

# IndianAPI.in is consulted only in the per-symbol fallback path, and only
# when explicitly enabled — it has been returning HTTP 429 for this key, so
# enabling it just adds a wasted round trip per symbol before RSS is tried.
NEWS_USE_INDIANAPI=false
